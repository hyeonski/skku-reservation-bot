// Phase 1 스키마 — D-022(Space), D-023(Client, Conversation) 반영.
// 시딩은 server/scripts/scrape-spaces.ts 에서 dsCboSpace를 dump하여 Space로 upsert.
//
// 컨벤션: TS 모델 식별자는 camelCase, DB 식별자는 snake_case (@@map / @map 으로 매핑).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- 사용자 (확장 설치 시 발급된 UUID) ----------

model Client {
  id            String         @id @db.Char(36) // UUID v4
  createdAt     DateTime       @default(now()) @map("created_at")
  lastSeenAt    DateTime       @updatedAt @map("last_seen_at")
  conversations Conversation[]
  reminders     Reminder[]
  spaceFeedbackEvents SpaceFeedbackEvent[]
  reservationRecords  ReservationRecord[]
  patternMutes        PatternMute[]

  @@map("client")
}

// ---------- 대화 (D-018: 클라 권위 + 서버 매 턴 mirror) ----------

enum ConversationStatus {
  active
  completed
  abandoned_user
  abandoned_timeout
}

enum ReminderStatus {
  active
  dismissed
  accepted
  expired
}

enum SpaceFeedbackEventType {
  rejected_candidate
}

model Conversation {
  id       String @id @db.Char(36)
  clientId String @map("client_id") @db.Char(36)
  client   Client @relation(fields: [clientId], references: [id])

  status          ConversationStatus @default(active)
  history         Json
  title           String?           @db.VarChar(191)
  lastIntent      String?            @map("last_intent") @db.VarChar(40)
  lastFilledSlots Json?              @map("last_filled_slots")
  lastApplicationState Json?         @map("last_application_state")
  confirmedReservationForm Json?     @map("confirmed_reservation_form")
  confirmedReservationLabel String?  @map("confirmed_reservation_label") @db.VarChar(191)
  confirmedSpaceCode String?         @map("confirmed_space_code") @db.VarChar(40)
  confirmedSpaceLabel String?        @map("confirmed_space_label") @db.VarChar(191)

  startedAt   DateTime  @default(now()) @map("started_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([clientId, updatedAt])
  @@index([status, updatedAt])
  @@index([clientId, deletedAt, updatedAt])
  @@map("conversation")
}

// ---------- P3 패턴 리마인드 ----------

model Reminder {
  id       String @id @default(uuid()) @db.Char(36)
  clientId String @map("client_id") @db.Char(36)
  client   Client @relation(fields: [clientId], references: [id])

  status ReminderStatus @default(active)

  patternKey   String @map("pattern_key") @db.VarChar(191)
  title        String @db.VarChar(191)
  pattern      String @db.VarChar(255)
  proposedDate String @map("proposed_date") @db.VarChar(10)
  startTime    String @map("start_time") @db.VarChar(5)
  endTime      String @map("end_time") @db.VarChar(5)
  headcount    Int
  organization String @db.VarChar(191)
  eventName    String @map("event_name") @db.VarChar(191)
  spaceLabel   String? @map("space_label") @db.VarChar(191)
  spaceCode    String? @map("space_code") @db.VarChar(40)
  prompt       String @db.Text

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  dismissedAt DateTime? @map("dismissed_at")
  acceptedAt  DateTime? @map("accepted_at")
  expiredAt   DateTime? @map("expired_at")

  @@unique([clientId, patternKey, proposedDate])
  @@index([clientId, status, proposedDate])
  @@map("reminder")
}

// ---------- 패턴 음소거 (연속 거절 시 그 패턴 제안 억제) ----------
// clearedAt = null 이면 음소거 활성. accept 또는 음소거 이후 재완료 시 clearedAt 세팅.

model PatternMute {
  id         String    @id @default(uuid()) @db.Char(36)
  clientId   String    @map("client_id") @db.Char(36)
  client     Client    @relation(fields: [clientId], references: [id])
  patternKey String    @map("pattern_key") @db.VarChar(191)
  mutedAt    DateTime  @default(now()) @map("muted_at")
  clearedAt  DateTime? @map("cleared_at")

  @@index([clientId, patternKey, clearedAt])
  @@map("pattern_mute")
}

// ---------- 예약 완료 이력 (reminder 패턴 감지의 단일 데이터원) ----------
// 예약 제출 완료 시점에 신청서·슬롯 정보를 평면 1행으로 append 한다.
// Conversation(대화 transcript)에서 예약 사실을 추출하던 방식을 대체한다.

model ReservationRecord {
  id             String @id @default(uuid()) @db.Char(36)
  clientId       String @map("client_id") @db.Char(36)
  client         Client @relation(fields: [clientId], references: [id])
  conversationId String @unique @map("conversation_id") @db.Char(36) // 대화당 1예약 = 멱등 키

  date      String @db.VarChar(10) // YYYY-MM-DD
  weekday   Int // 0~6, date에서 파생 저장(패턴 그룹핑용)
  startTime String @map("start_time") @db.VarChar(5)
  endTime   String @map("end_time") @db.VarChar(5)
  headcount Int

  organization String @db.VarChar(191)
  eventName    String @map("event_name") @db.VarChar(191)
  purpose      String @db.Text
  hangsaGbCode String @map("hangsa_gb_code") @db.VarChar(8)

  spaceCode  String? @map("space_code") @db.VarChar(40)
  spaceLabel String? @map("space_label") @db.VarChar(191)

  reservedAt DateTime @map("reserved_at") // 예약 완료 시각
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([clientId, reservedAt])
  @@map("reservation_record")
}

// ---------- 공간 선호/비선호 이벤트 ----------

model SpaceFeedbackEvent {
  id             String                 @id @default(uuid()) @db.Char(36)
  clientId       String                 @map("client_id") @db.Char(36)
  client         Client                 @relation(fields: [clientId], references: [id])
  conversationId String                 @map("conversation_id") @db.Char(36)
  spaceCode      String                 @map("space_code") @db.VarChar(40)
  eventType      SpaceFeedbackEventType @map("event_type")
  date           String?                @db.VarChar(10)
  startTime      String?                @map("start_time") @db.VarChar(5)
  createdAt      DateTime               @default(now()) @map("created_at")

  @@index([clientId, spaceCode, eventType, createdAt], map: "sfe_client_space_event_created_idx")
  @@index([clientId, conversationId, spaceCode, eventType], map: "sfe_client_conversation_space_event_idx")
  @@map("space_feedback_event")
}

// ---------- 공간 메타데이터 (D-022) ----------

model Space {
  id String @id @default(uuid()) @db.Char(36)

  // GLS 식별 코드 (자동화 1순위)
  glsSpaceCode String @unique @map("gls_space_code") @db.VarChar(40) // GU_SPACE_CD
  campusCode   String @map("campus_code") @db.VarChar(8) // CAMPUS_CD "1" | "2"
  buildingNo   String @map("building_no") @db.VarChar(16) // BUILD_NO

  // 표시명
  campusName   String @map("campus_name") @db.VarChar(40)
  buildingName String @map("building_name") @db.VarChar(80)
  roomName     String @map("room_name") @db.VarChar(120)

  // 정원 범위
  capacityMin Int @map("capacity_min")
  capacityMax Int @map("capacity_max")

  // 학과 제한 / 운영 주체
  useJojikCode   String? @map("use_jojik_code") @db.VarChar(20)
  useJojikName   String? @map("use_jojik_name") @db.VarChar(120)
  adminJojikCode String? @map("admin_jojik_code") @db.VarChar(20)
  adminJojikName String? @map("admin_jojik_name") @db.VarChar(120)

  // 공지 / 제약
  contents      String? @db.Text
  limitDayYn    Boolean @default(false) @map("limit_day_yn")
  limitDay      Int?    @map("limit_day")
  limitTimeYn   Boolean @default(false) @map("limit_time_yn")
  limitTimeHHMM String? @map("limit_time_hhmm") @db.VarChar(4)
  daeyeoGb      String? @map("daeyeo_gb") @db.VarChar(4)

  // 시딩 관리
  scrapedAt DateTime @map("scraped_at")
  active    Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([capacityMin, capacityMax])
  @@index([campusCode, buildingNo])
  @@index([useJojikCode])
  @@map("space")
}
