{
  "name": "skku-reservation-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "scrape:spaces": "tsx --env-file=.env scripts/scrape-spaces.ts",
    "verify:spaces": "tsx scripts/verify-space-personalization.ts",
    "verify:reminders": "tsx scripts/verify-reminder-space-code.ts",
    "verify:feedback": "tsx scripts/verify-space-feedback-route.ts",
    "verify": "tsx scripts/verify-space-personalization.ts && tsx scripts/verify-reminder-space-code.ts && tsx scripts/verify-space-feedback-route.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "openai": "^4.73.0",
    "playwright": "^1.49.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
