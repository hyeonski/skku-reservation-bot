PORT=8787

# 팀 MySQL 서버 접속 정보입니다. 팀 미팅 때 실제 값을 채워 넣으세요.
MYSQL_HOST=
MYSQL_PORT=13406
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=skku_reservation_agent

# 실제 LLM API 연결 설정입니다. 브라우저 코드에 키를 넣지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=

# 개발 중에는 확장 프로그램 popup에서 localhost API를 호출합니다.
CORS_ORIGIN=chrome-extension://*
