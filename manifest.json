{
  "manifest_version": 3,
  "name": "교내 공간 예약 에이전트",
  "description": "자연어 요청으로 교내 공간 예약 후보를 찾고 GLS 폼 입력을 보조합니다.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "교내 예약"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.skku.edu/*", "*://*.skku.ac.kr/*"],
      "js": ["src/selectors.js", "src/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "host_permissions": ["*://*.skku.edu/*", "*://*.skku.ac.kr/*", "http://*/*", "https://*/*"]
}
